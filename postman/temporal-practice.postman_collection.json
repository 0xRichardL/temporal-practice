    {
      "key": "fraud_base_url",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "account_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "amount",
      "value": "100",
      "type": "string"
    },
    {
      "key": "fraud_is_valid",
      "value": "true",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
